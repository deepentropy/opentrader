{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Shared drawing core (sibling repo lightweight-charts-drawing); its
       lightweight-charts type imports resolve to this project's build. */
    "paths": {
      "lightweight-charts": ["./node_modules/lightweight-charts"],
      "lightweight-charts-drawing/core/*": ["../lightweight-charts-drawing/src/core/*"],
      "lightweight-charts-drawing/runtime/*": ["../lightweight-charts-drawing/src/runtime/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
