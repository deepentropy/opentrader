// OpenTrader Community: API Worker + D1 database.
// Local run: `npm run dev` (test sign-in on, local database: `npm run db:local`).
// Deploy: `npm run db:remote` once per new migration, then `npm run deploy`.
// Secrets (`wrangler secret put`): GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_SECRET,
// DISCORD_CLIENT_SECRET (a provider without its id and secret is not offered),
// TURNSTILE_SECRET, GATEWAY_TOKEN. Paid tier (#252, off until set):
// PASS_PRIVATE_KEY (scripts/pass-keys.mjs), GATEWAY_ADMIN_TOKEN (the gateway's
// REALTIME_ADMIN_TOKEN), STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID;
// webhook URL <PUBLIC_URL>/billing/webhook.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentrader-community",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "community.opentrader.markets", "custom_domain": true }],
  // The website: `npm run build:community` at the repository root writes ./site.
  // Every request reaches the Worker first (HTTPS redirect, API, page titles),
  // which hands the rest to the website's files.
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opentrader-community",
      "database_id": "ec05e71e-d435-48d5-90db-865be4f6f4f8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "opentrader-community" }],
  // Live comments: one room per post (src/live.ts).
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PostRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PostRoom"] }],
  // Bursts per connection (#210): sign-ins, and writes.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "2101", "simple": { "limit": 20, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "2102", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_URL": "https://community.opentrader.markets",
    "ALLOWED_ORIGINS": "https://demo.opentrader.markets",
    "WEB_REDIRECTS": "https://demo.opentrader.markets/community-auth.html,https://community.opentrader.markets/community-auth.html",
    // provider:provider_id, comma-separated.
    "ADMINS": "google:112079201386783875064",
    "GITHUB_CLIENT_ID": "Ov23lijxOPdc4uYuL0ya",
    "GOOGLE_CLIENT_ID": "541505217152-qn4re9p4m6htg5fe2t9h5ojvhg4ip8os.apps.googleusercontent.com",
    "DISCORD_CLIENT_ID": "1567124030622924901",
    // Bot check at sign-in; its secret is TURNSTILE_SECRET.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFx6K_eX2hXdUuKw",
    // Ticker communities only for known symbols; its token is GATEWAY_TOKEN.
    "GATEWAY_URL": "https://opentrader-gateway.cloudflare-breeder165.workers.dev"
  },
  "env": {
    // `wrangler dev --env local`: the test sign-in, the Vite dev servers.
    "local": {
      "vars": {
        "PUBLIC_URL": "http://127.0.0.1:8788",
        "ALLOWED_ORIGINS": "http://localhost:1420,http://localhost:1430,http://localhost:1440,http://localhost:1450",
        "WEB_REDIRECTS": "http://localhost:1430/community-auth.html,http://127.0.0.1:8788/community-auth.html,http://localhost:1450/community-auth.html",
        "ADMINS": "",
        "DEV_LOGIN": "1",
        "DEV_ADMINS": "dev:admin",
        "GITHUB_CLIENT_ID": "",
        "GOOGLE_CLIENT_ID": "",
        "DISCORD_CLIENT_ID": "",
        // Turnstile's test keys: the check always passes.
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA"
      },
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "2101", "simple": { "limit": 20, "period": 60 } },
        { "name": "WRITE_LIMITER", "namespace_id": "2102", "simple": { "limit": 30, "period": 60 } }
      ],
      "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "opentrader-community" }],
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PostRoom" }] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "opentrader-community",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  // Every half hour on weekdays; index.ts runs by the hour: the bot's threads (13:00, 16:00 UTC), idea prices
  // (14:00 to 21:30), the ideas settled on the day's bars (22:30), subscriptions read back (23:00).
  "triggers": { "crons": ["*/30 * * * 1-5"] },
  "observability": { "enabled": true }
}
