// The web version on Cloudflare: static frontend + one server container.
// Deployed by .github/workflows/web-image.yml (needs Docker to build the image).
// Secret: OPENTRADER_GATEWAY_TOKEN (`wrangler secret put`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentrader-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // The public address (Cloudflare creates its DNS record and certificate).
  "routes": [{ "pattern": "demo.opentrader.markets", "custom_domain": true }],
  "assets": {
    "directory": "../../dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "containers": [
    {
      "class_name": "OpenTraderServer",
      "image": "../../src-tauri/crates/server/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      // 2: a renamed instance (see INSTANCE) starts while the old one winds down.
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SERVER", "class_name": "OpenTraderServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OpenTraderServer"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://demo.opentrader.markets,https://opentrader-web.cloudflare-breeder165.workers.dev"
  },
  "observability": { "enabled": true }
}
