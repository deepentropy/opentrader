# The web version in one image: the server (src-tauri/crates/server) serving
# the built frontend (dist-web) and the API on one origin.
#
# Build from the repository root, after `npm run build:web` (the frontend
# build needs src/bindings.ts, generated by the desktop crate's tests):
#   docker build -f src-tauri/crates/server/Dockerfile -t opentrader-web .
# Run:
#   docker run -p 8080:8080 -e OPENTRADER_GATEWAY_TOKEN=... -v opentrader-cache:/data opentrader-web

FROM rust:1-bookworm AS server
WORKDIR /build
COPY src-tauri ./src-tauri
RUN cd src-tauri && cargo build --release --locked -p opentrader-server

# Compressed copies of the frontend files (served as is when the browser accepts them).
FROM debian:bookworm-slim AS web
RUN apt-get update && apt-get install -y --no-install-recommends brotli && rm -rf /var/lib/apt/lists/*
COPY dist-web /web
RUN find /web -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.svg' -o -name '*.json' -o -name '*.wasm' \) \
    -exec brotli -q 11 -k {} \; -exec gzip -9 -k {} \;

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=server /build/src-tauri/target/release/opentrader-server /usr/local/bin/opentrader-server
COPY --from=web /web /app/web
# The cache volume must be writable by the unprivileged user.
RUN mkdir -p /data/cache && chown -R nobody:nogroup /data
ENV OPENTRADER_BIND=0.0.0.0:8080 \
    OPENTRADER_STATIC_DIR=/app/web \
    OPENTRADER_CACHE_DIR=/data/cache
VOLUME /data
EXPOSE 8080
USER nobody
CMD ["opentrader-server"]
