        { "quote": { "symbol": "X:A", "last": 101, "bar": null, "now": 15 }, "fires": [["r", 101, 15, 0]] },
        { "quote": { "symbol": "X:A", "last": 102, "bar": null, "now": 20 }, "fires": [] },
