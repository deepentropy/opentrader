{
  "about": "Alert evaluation vectors run by engine.rs (cargo test) and by src/data/__tests__/alert-eval.test.ts (vitest): both must give these fires. A rule lists only what differs from ruleDefaults (its `and` conditions too). Steps: quote {symbol, last, bar: [time, open, high, low, close] | null, now}; set {rules, now} (expect `jobs`); finishReplay {bars | null} (every job of the last set); replay {rule, grid, from, bars}. Fires: [ruleId, price, time, barTime], sorted by rule id.",
  "constants": { "everyTimeSec": 60, "replayMaxSec": 2592000, "replayMinGapSec": 120, "replayMaxFires": 50 },
  "ruleDefaults": {
    "id": "r",
    "symbol": "X:A",
    "sig": "1",
    "op": "greater",
    "shape": "level",
    "frequency": "every_time",
    "expiresAt": null,
    "since": 0,
    "grid": "g",
    "values": [],
    "perBar": null,
    "absentIsOutside": false,
    "and": []
  },
