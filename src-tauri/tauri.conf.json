{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTrader",
  "version": "0.1.1",
  "identifier": "com.opentrader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenTrader",
        "width": 1440,
        "height": 900,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OpenTrader",
    "copyright": "© 2026 OpenTrader contributors. MIT License.",
    "category": "Finance",
    "shortDescription": "Desktop charting app",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFOTE5N0MyMDEzMTk3MkQKUldRdGx6RUJ3cGVSM2d3NzdWUHNXRjFzYmFmVHZqSDZqSVlnN205bE9VL0tnaTUvcFd2MEhhbTkK",
      "endpoints": [
        "https://github.com/deepentropy/opentrader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
