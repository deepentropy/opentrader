{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTrader",
  "version": "0.1.0",
  "identifier": "com.opentrader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenTrader",
        "width": 1440,
        "height": 900,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Odyssée",
    "copyright": "© 2026 Odyssée. MIT License.",
    "category": "Finance",
    "shortDescription": "Desktop charting app",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
